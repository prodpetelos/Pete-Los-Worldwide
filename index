// ---- WINDOW MGMT ----
function focusWin(id){
  const w=document.getElementById(id);if(!w)return;
  if(w.classList.contains('hidden')){showWin(id);return;}
  zTop++;w.style.zIndex=zTop;
  document.querySelectorAll('.win .titlebar').forEach(tb=>tb.style.background=tb.closest('.win').id===id?'var(--blue)':'var(--dark)');
  document.querySelectorAll('.tb-btn').forEach(b=>b.classList.remove('active'));
  const map={' win-main':'tbb-main','win-cart':'tbb-cart','win-contact':'tbb-contact'};
  if(map[id])document.getElementById(map[id])?.classList.add('active');
}
function showWin(id){document.getElementById(id)?.classList.remove('hidden');focusWin(id);}
function closeWin(id){document.getElementById(id)?.classList.add('hidden');}
function minWin(id){document.getElementById(id)?.classList.add('hidden');}

// Draggable
function makeDrag(winId,barId){
  const w=document.getElementById(winId),b=document.getElementById(barId);
  if(!w||!b)return;
  b.addEventListener('mousedown',e=>{
    if(e.target.classList.contains('tbtn'))return;
    focusWin(winId);
    const ox=e.clientX,oy=e.clientY,rect=w.getBoundingClientRect(),sl=rect.left,st=rect.top;
    function mm(e){w.style.left=(sl+e.clientX-ox)+'px';w.style.top=(st+e.clientY-oy)+'px';w.style.right='auto';}
    function mu(){document.removeEventListener('mousemove',mm);document.removeEventListener('mouseup',mu);}
    document.addEventListener('mousemove',mm);document.addEventListener('mouseup',mu);
  });
}
makeDrag('win-main','tb-main');makeDrag('win-cart','tb-cart');makeDrag('win-contact','tb-contact');

// Dialogs
function showDlg(id){document.getElementById(id).classList.add('open');}
function closeDlg(id){document.getElementById(id).classList.remove('open');}

// Status
function setStatus(msg){document.getElementById('stat-msg').textContent=msg;}

// Clock
function tick(){const n=new Date();let h=n.getHours(),m=n.getMinutes();const a=h>=12?'PM':'AM';h=h%12||12;document.getElementById('clock').textContent=h+':'+String(m).padStart(2,'0')+' '+a;}
tick();setInterval(tick,10000);

// Resize main window
(function(){
  const handle=document.getElementById('resize-handle-main');
  const win=document.getElementById('win-main');
  if(!handle||!win)return;
  handle.addEventListener('mousedown',function(e){
    e.preventDefault();e.stopPropagation();
    const startX=e.clientX,startY=e.clientY;
    const startW=win.offsetWidth,startH=win.offsetHeight;
    function onMove(e){
      const nw=Math.max(400,startW+(e.clientX-startX));
      const nh=Math.max(300,startH+(e.clientY-startY));
      win.style.width=nw+'px';win.style.height=nh+'px';
    }
    function onUp(){document.removeEventListener('mousemove',onMove);document.removeEventListener('mouseup',onUp);}
    document.addEventListener('mousemove',onMove);document.addEventListener('mouseup',onUp);
  });
})();

// Screensaver
let ssTimer=null,ssX=100,ssY=100,ssDX=2,ssDY=2,ssAnimFrame=null;
function startScreensaver(){
  const ss=document.getElementById('screensaver');
  ss.style.display='block';
  ssX=100;ssY=100;ssDX=2.5;ssDY=2.5;
  function animate(){
    const img=document.getElementById('ss-img');
    const w=window.innerWidth-80,h=window.innerHeight-80;
    ssX+=ssDX;ssY+=ssDY;
    if(ssX<=0||ssX>=w){ssDX*=-1;ssX=Math.max(0,Math.min(ssX,w));}
    if(ssY<=0||ssY>=h){ssDY*=-1;ssY=Math.max(0,Math.min(ssY,h));}
    img.style.left=ssX+'px';img.style.top=ssY+'px';
    ssAnimFrame=requestAnimationFrame(animate);
  }
  cancelAnimationFrame(ssAnimFrame);animate();
}
function stopScreensaver(){
  document.getElementById('screensaver').style.display='none';
  cancelAnimationFrame(ssAnimFrame);resetSsTimer();
}
function resetSsTimer(){clearTimeout(ssTimer);ssTimer=setTimeout(startScreensaver,60000);}
document.addEventListener('mousemove',resetSsTimer);
document.addEventListener('keydown',function(e){if(document.getElementById('screensaver').style.display==='block'){stopScreensaver();}else{resetSsTimer();}});
resetSsTimer();

// Init
renderBeats();selBeat(1);
</script>
