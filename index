<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pete Los Beat Store - Windows 98</title>
<link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #008080;
    --face: #c0c0c0;
    --dark: #808080;
    --darker: #404040;
    --light: #ffffff;
    --black: #000000;
    --blue: #000080;
    --accent: #0000aa;
    --green: #00ff00;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:var(--bg) url('data:image/jpeg;base64,') center/cover no-repeat fixed;font-family:'MS Sans Serif',Tahoma,Arial,sans-serif;font-size:11px;min-height:100vh;cursor:default;user-select:none;}
  body::after{content:'';position:fixed;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 1px,rgba(0,0,0,0.03) 2px);pointer-events:none;z-index:9999;}

  /* --- WIN98 BORDER UTILS --- */
  .raised{border:2px solid;border-color:var(--light) var(--darker) var(--darker) var(--light);}
  .sunken{border:2px solid;border-color:var(--darker) var(--light) var(--light) var(--darker);}
  .sunken-inner{border:1px solid;border-color:var(--dark) var(--face) var(--face) var(--dark);}

  /* --- TASKBAR --- */
  .taskbar{position:fixed;bottom:0;left:0;right:0;height:28px;background:var(--face);border-top:2px solid var(--light);display:flex;align-items:center;padding:2px 3px;gap:3px;z-index:500;}
  .start-btn{display:flex;align-items:center;gap:3px;padding:1px 6px 1px 4px;font-weight:bold;font-size:11px;cursor:pointer;height:22px;background:var(--face);border:2px solid;border-color:var(--light) var(--darker) var(--darker) var(--light);}
  .start-btn:active{border-color:var(--darker) var(--light) var(--light) var(--darker);}
  .win-logo{width:16px;height:16px;display:grid;grid-template-columns:1fr 1fr;gap:1px;}
  .win-logo div:nth-child(1){background:#ff3333;}
  .win-logo div:nth-child(2){background:#33bb33;}
  .win-logo div:nth-child(3){background:#3333ff;}
  .win-logo div:nth-child(4){background:#ffcc00;}
  .tb-sep{width:2px;height:20px;border-left:1px solid var(--dark);border-right:1px solid var(--light);margin:0 1px;}
  .tb-btn{height:22px;padding:1px 8px;font-size:11px;cursor:pointer;background:var(--face);border:2px solid;border-color:var(--light) var(--darker) var(--darker) var(--light);white-space:nowrap;max-width:150px;overflow:hidden;text-overflow:ellipsis;}
  .tb-btn.active{border-color:var(--darker) var(--light) var(--light) var(--darker);background:#b8b8b8;}
  .tb-clock{margin-left:auto;padding:1px 6px;font-size:11px;border:1px solid;border-color:var(--dark) var(--light) var(--light) var(--dark);}

  /* --- WINDOW --- */
  .win{position:fixed;background:var(--face);border:2px solid;border-color:var(--light) var(--darker) var(--darker) var(--light);display:flex;flex-direction:column;box-shadow:2px 2px 0 rgba(0,0,0,0.4);}
  .win.resizable{overflow:hidden;min-width:400px;min-height:300px;}
  .resize-handle{position:absolute;bottom:0;right:0;width:14px;height:14px;cursor:se-resize;background:linear-gradient(135deg,transparent 35%,var(--dark) 35%,var(--dark) 50%,var(--light) 50%,var(--light) 60%,var(--darker) 60%,var(--darker) 75%,transparent 75%);z-index:5;}
  .win.hidden{display:none!important;}
  .titlebar{background:var(--blue);padding:2px 3px;display:flex;align-items:center;gap:4px;cursor:move;min-height:18px;}
  .titlebar-text{color:#fff;font-weight:bold;font-size:11px;flex:1;white-space:nowrap;overflow:hidden;display:flex;align-items:center;gap:5px;}
  .titlebar-btns{display:flex;gap:2px;flex-shrink:0;}
  .tbtn{width:16px;height:14px;background:var(--face);border:1px solid;border-color:var(--light) var(--darker) var(--darker) var(--light);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:9px;font-weight:bold;line-height:1;color:#000;}
  .tbtn:active{border-color:var(--darker) var(--light) var(--light) var(--darker);}
  .tbtn.close{margin-left:2px;}
  .menubar{background:var(--face);padding:1px 0;display:flex;border-bottom:1px solid var(--dark);}
  .mitem{padding:2px 8px;font-size:11px;cursor:pointer;}
  .mitem:hover{background:var(--blue);color:#fff;}
  .wbody{flex:1;overflow:auto;padding:6px;}

  /* --- TABS --- */
  .tabrow{display:flex;gap:2px;padding:4px 6px 0;background:var(--face);}
  .tab{padding:2px 12px 3px;font-size:11px;cursor:pointer;background:var(--face);border:2px solid;border-color:var(--light) var(--darker) var(--face) var(--light);position:relative;bottom:-2px;z-index:1;}
  .tab.active{font-weight:bold;border-bottom-color:var(--face);z-index:3;padding-bottom:4px;}
  .tabcontent{display:none;padding:6px;border-top:2px solid var(--dark);}
  .tabcontent.active{display:block;}

  /* --- BUTTONS --- */
  .btn{padding:5px 18px;font-size:12px;font-family:inherit;cursor:pointer;background:var(--face);border:2px solid;border-color:var(--light) var(--darker) var(--darker) var(--light);min-width:80px;text-align:center;white-space:nowrap;}
  .btn:active,.btn.pressed{border-color:var(--darker) var(--light) var(--light) var(--darker);padding:6px 17px 4px 19px;}
  .btn.default{outline:1px solid #000;outline-offset:-2px;}
  .btnx{padding:4px 10px;font-size:12px;font-family:inherit;cursor:pointer;background:var(--face);border:2px solid;border-color:var(--light) var(--darker) var(--darker) var(--light);}
  .btnx:active{border-color:var(--darker) var(--light) var(--light) var(--darker);}

  /* --- LISTVIEW --- */
  .listview{background:#fff;border:2px solid;border-color:var(--darker) var(--light) var(--light) var(--darker);overflow:auto;}
  .listview table{width:100%;border-collapse:collapse;font-size:11px;}
  .listview thead th{background:var(--face);padding:2px 5px;text-align:left;border-right:1px solid var(--dark);border:2px solid;border-color:var(--light) var(--darker) var(--darker) var(--light);white-space:nowrap;font-weight:normal;cursor:pointer;}
  .listview thead th:active{border-color:var(--darker) var(--light) var(--light) var(--darker);}
  .listview tbody tr{cursor:pointer;}
  .listview tbody tr:hover td{background:#e8e8e8;}
  .listview tbody tr.sel td{background:var(--blue);color:#fff;}
  .listview tbody td{padding:1px 5px;border-bottom:1px solid #ddd;white-space:nowrap;}

  /* --- PLAYER --- */
  .playerbar{background:var(--face);padding:4px 6px;border-top:2px solid var(--light);display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
  .display{font-family:'VT323',monospace;font-size:15px;color:#00ff00;background:#000030;padding:3px 8px;border:2px solid;border-color:var(--darker) var(--light) var(--light) var(--darker);flex:1;min-width:100px;white-space:nowrap;overflow:hidden;}
  .eqdisplay{display:flex;align-items:flex-end;gap:2px;height:18px;}
  .eqb{width:4px;background:#00ff00;min-height:2px;}
  @keyframes eq1{0%,100%{height:3px}50%{height:16px}}
  @keyframes eq2{0%,100%{height:10px}30%{height:3px}70%{height:18px}}
  @keyframes eq3{0%,100%{height:14px}50%{height:5px}}
  @keyframes eq4{0%,100%{height:6px}40%{height:14px}}
  @keyframes eq5{0%,100%{height:12px}60%{height:3px}}
  .playing .eqb:nth-child(1){animation:eq1 .55s infinite;}
  .playing .eqb:nth-child(2){animation:eq2 .45s infinite;}
  .playing .eqb:nth-child(3){animation:eq3 .65s infinite;}
  .playing .eqb:nth-child(4){animation:eq4 .5s infinite;}
  .playing .eqb:nth-child(5){animation:eq5 .6s infinite;}
  .progress-wrap{width:100%;height:12px;border:2px solid;border-color:var(--darker) var(--light) var(--light) var(--darker);background:#fff;cursor:pointer;margin:2px 0;}
  .progress-fill{height:100%;background:var(--blue);width:0%;transition:width .3s linear;}

  /* --- STATUS BAR --- */
  .statusbar{display:flex;gap:2px;padding:1px 3px;margin-top:auto;}
  .statpanel{padding:0px 5px;font-size:11px;border:1px solid;border-color:var(--dark) var(--light) var(--light) var(--dark);flex:1;line-height:16px;}

  /* --- LICENSES --- */
  .lic-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;}
  .licbox{border:2px solid;border-color:var(--light) var(--darker) var(--darker) var(--light);background:var(--face);display:flex;flex-direction:column;}
  .licbox-title{padding:2px 6px;font-weight:bold;font-size:11px;display:flex;align-items:center;gap:4px;color:#fff;}
  .licbox-body{padding:8px;flex:1;display:flex;flex-direction:column;gap:4px;}
  .lic-price{font-family:'VT323',monospace;font-size:38px;line-height:1;text-align:center;padding:4px 0;}
  .licfeat{font-size:11px;display:flex;align-items:center;gap:4px;padding:1px 0;}
  .licfeat::before{content:'✓';color:var(--blue);font-weight:bold;}
  .licfeat.no{color:var(--dark);}
  .licfeat.no::before{content:'✗';color:var(--dark);}

  /* --- FORM --- */
  .ftable{width:100%;border-spacing:3px 5px;}
  .ftable td{font-size:11px;vertical-align:middle;}
  .ftable td:first-child{white-space:nowrap;width:1px;}
  .winput{width:100%;border:2px solid;border-color:var(--darker) var(--light) var(--light) var(--darker);padding:2px 4px;font-size:11px;font-family:inherit;background:#fff;outline:none;}
  .winput:focus{outline:1px dotted #000;outline-offset:-1px;}
  .wselect{width:100%;border:2px solid;border-color:var(--darker) var(--light) var(--light) var(--darker);padding:2px 4px;font-size:11px;font-family:inherit;background:#fff;outline:none;appearance:none;}
  .wtextarea{width:100%;border:2px solid;border-color:var(--darker) var(--light) var(--light) var(--darker);padding:4px;font-size:11px;font-family:inherit;background:#fff;outline:none;resize:vertical;}

  /* --- GROUPBOX --- */
  .gbox{border:1px solid;border-color:var(--darker) var(--light) var(--light) var(--darker);padding:10px 8px 8px;margin:6px 0;position:relative;}
  .gbox-lbl{position:absolute;top:-7px;left:8px;background:var(--face);padding:0 3px;font-size:11px;}

  /* --- SEP --- */
  .sep{height:2px;border-top:1px solid var(--darker);border-bottom:1px solid var(--light);margin:5px 0;}

  /* --- MARQUEE (hidden) --- */
  .marquee{display:none;}

  /* --- DIALOGS --- */
  .dlg-overlay{display:none;position:fixed;inset:0;z-index:600;align-items:center;justify-content:center;background:rgba(0,0,0,0.2);}
  .dlg-overlay.open{display:flex;}
  .dlg{background:var(--face);border:2px solid;border-color:var(--light) var(--darker) var(--darker) var(--light);min-width:280px;box-shadow:3px 3px 0 rgba(0,0,0,0.4);}
  .dlg-body{padding:14px;display:flex;gap:10px;align-items:flex-start;}
  .dlg-icon{font-size:28px;flex-shrink:0;}
  .dlg-text{font-size:11px;line-height:1.7;}
  .dlg-btns{padding:6px;display:flex;justify-content:center;gap:6px;border-top:1px solid var(--dark);}

  /* --- DESKTOP --- */
  .desktop{padding:6px;display:flex;flex-direction:column;gap:2px;align-items:flex-start;padding-bottom:32px;}
  .dicon{display:flex;flex-direction:column;align-items:center;gap:1px;padding:3px;width:68px;cursor:pointer;text-align:center;}
  .dicon:hover .dicon-lbl,.dicon.sel .dicon-lbl{background:var(--blue);color:#fff;outline:1px dotted #fff;}
  .dicon-img{font-size:26px;}
  .dicon-lbl{font-size:11px;padding:1px 2px;color:#fff;text-shadow:1px 1px 1px #000;}

  /* scrollbar */
  ::-webkit-scrollbar{width:16px;height:16px;}
  ::-webkit-scrollbar-track{background:var(--face);}
  ::-webkit-scrollbar-thumb{background:var(--face);border:2px solid;border-color:var(--light) var(--darker) var(--darker) var(--light);}
  ::-webkit-scrollbar-button{background:var(--face);border:2px solid;border-color:var(--light) var(--darker) var(--darker) var(--light);display:block;height:16px;width:16px;}


  /* --- SCREENSAVER --- */
  #screensaver{display:none;position:fixed;inset:0;z-index:9998;background:#000;cursor:none;}
  #screensaver img{position:absolute;width:80px;height:80px;image-rendering:pixelated;}
  #screensaver-hint{position:absolute;bottom:20px;width:100%;text-align:center;color:#333;font-size:11px;font-family:'MS Sans Serif',Arial,sans-serif;}

  @media(max-width:680px){
    #win-main{width:calc(100vw - 8px)!important;left:4px!important;top:4px!important;height:calc(100vh - 36px)!important;}
    .lic-grid{grid-template-columns:1fr;}
    #win-cart,#win-contact{display:none!important;}
  }
</style>
</head>
<body>

<div class="desktop">
