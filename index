// ---- RENDER ----
function renderBeats(){
  document.getElementById('beat-tbody').innerHTML=BEATS.map((b,i)=>`
    <tr id="brow-${b.id}" onclick="selBeat(${b.id})" ondblclick="selBeat(${b.id});togglePlay()">
      <td><span id="pind-${b.id}" style="visibility:hidden;color:var(--blue);">▶</span></td>
      <td>${String(i+1).padStart(2,'0')}</td>
      <td>${b.title}</td>
      <td>${b.genre}</td>
      <td>${b.bpm}</td>
      <td>${b.key}</td>
      <td>${b.dur}</td>
      <td>$29+</td>
    </tr>`).join('');
}

function selBeat(id){
  selId=id;
  document.querySelectorAll('#beat-tbody tr').forEach(r=>r.classList.remove('sel'));
  document.getElementById('brow-'+id)?.classList.add('sel');
  const b=BEATS.find(x=>x.id===id);
  setStatus(`${b.title} — ${b.genre} — ${b.bpm} BPM — ${b.key}`);
}

// ---- PLAYBACK ----
function togglePlay(){
  if(!selId)selBeat(1);
  playing?stopPlay():playSelected();
}
let audioEl=null;
function playSelected(){
  if(!selId)selBeat(1);
  const b=BEATS.find(x=>x.id===selId);
  if(!b)return;
  if(playId&&playId!==selId){
    document.getElementById('pind-'+playId).style.visibility='hidden';
    if(audioEl){audioEl.pause();audioEl.currentTime=0;}
  }
  playId=selId;playing=true;
  document.getElementById('pind-'+b.id).style.visibility='visible';
  document.getElementById('playbtn').textContent='■';
  document.getElementById('player-display').textContent='♪ '+b.title+'  '+b.bpm+' BPM';
  document.getElementById('eq').classList.add('playing');
  if(b.audio){
    if(!audioEl||audioEl.dataset.id!=b.id){
      if(audioEl)audioEl.pause();
      audioEl=new Audio(b.audio);
      audioEl.dataset.id=b.id;
      audioEl.addEventListener('timeupdate',()=>{
        const cur=audioEl.currentTime,dur=audioEl.duration||1;
        document.getElementById('prog-fill').style.width=(cur/dur*100)+'%';
        const m=Math.floor(cur/60),s=Math.floor(cur%60);
        document.getElementById('t-cur').textContent=m+':'+String(s).padStart(2,'0');
        const dm=Math.floor(dur/60),ds=Math.floor(dur%60);
        document.getElementById('t-tot').textContent=dm+':'+String(ds).padStart(2,'0');
      });
      audioEl.addEventListener('ended',()=>stopPlay());
    }
    audioEl.play();
  } else {
    if(pTimer)clearInterval(pTimer);
    pTimer=setInterval(()=>{prog++;if(prog>=b.secs)prog=0;updProg(b);},1000);
    updProg(b);
  }
}
function stopPlay(){
  playing=false;clearInterval(pTimer);
  if(audioEl){audioEl.pause();}
  document.getElementById('playbtn').textContent='▶';
  document.getElementById('eq').classList.remove('playing');
  if(playId)document.getElementById('pind-'+playId).style.visibility='hidden';
  document.getElementById('player-display').textContent='■ STOPPED';
  prog=0;document.getElementById('prog-fill').style.width='0%';
  document.getElementById('t-cur').textContent='0:00';
}
function updProg(b){
  document.getElementById('prog-fill').style.width=(prog/b.secs*100)+'%';
  document.getElementById('t-cur').textContent=Math.floor(prog/60)+':'+String(prog%60).padStart(2,'0');
}
function seekProg(e){
  if(!playId)return;
  const b=BEATS.find(x=>x.id===playId);
  if(audioEl&&audioEl.dataset.id==b.id){
    audioEl.currentTime=(e.offsetX/e.currentTarget.offsetWidth)*audioEl.duration;
  } else {
    prog=Math.floor(e.offsetX/e.currentTarget.offsetWidth*b.secs);
    updProg(b);
  }
}

// ---- TABS ----
function setTab(name){
  const names=['beats','licenses','about'];
  document.querySelectorAll('.tab').forEach((t,i)=>t.classList.toggle('active',names[i]===name));
  document.querySelectorAll('.tabcontent').forEach(c=>c.classList.remove('active'));
  document.getElementById('tab-'+name).classList.add('active');
}

// ---- CART ----
function addSelToCart(){
  if(!selId){setStatus('Please select a beat first.');return;}
  addToCart(selId);
}
function addToCart(id){
  const b=BEATS.find(x=>x.id===id);
  if(cart.find(i=>i.id===id)){
    document.getElementById('dlg-added-txt').innerHTML=`<b>${b.title}</b> is already in your cart.`;
    showDlg('dlg-added');return;
  }
  cart.push({id,title:b.title,lic:'Basic',price:20});
  updateCart();
  document.getElementById('dlg-added-txt').innerHTML=`<b>${b.title}</b> added to cart!<br><br>License: Basic Lease ($20)<br>You can change the license in the cart.`;
  showDlg('dlg-added');
}
function removeFromCart(id){cart=cart.filter(i=>i.id!==id);updateCart();}
function changeLic(id,lic){const item=cart.find(i=>i.id===id);if(item){item.lic=lic;item.price=LICS[lic];}updateCart();}
function clearCart(){cart=[];updateCart();}
function updateCart(){
  const total=cart.reduce((s,i)=>s+i.price,0);
  document.getElementById('cart-total').textContent='$'+total;
  document.getElementById('stat-cart').textContent='Cart: '+cart.length+' item'+(cart.length!==1?'s':'');
  document.getElementById('stat-total').textContent='$'+total+'.00';
  document.getElementById('cart-count-small').textContent=cart.length;
  const tb=document.getElementById('cart-tbody');
  if(!cart.length){tb.innerHTML='<tr><td colspan="4" style="padding:6px;color:var(--dark);font-style:italic;">Cart is empty</td></tr>';return;}
  tb.innerHTML=cart.map(item=>`
    <tr>
      <td style="max-width:100px;overflow:hidden;text-overflow:ellipsis;">${item.title}</td>
      <td><select class="wselect" style="width:86px;" onchange="changeLic(${item.id},this.value)">
        ${Object.entries(LICS).map(([l,p])=>`<option value="${l}"${item.lic===l?' selected':''}>$${p} ${l}</option>`).join('')}
      </select></td>
      <td>$${item.price}</td>
      <td><button class="btnx" onclick="removeFromCart(${item.id})">✕</button></td>
    </tr>`).join('');
}
function checkout(){
  if(!cart.length){document.getElementById('dlg-checkout-txt').textContent='Your cart is empty. Add some beats first!';showDlg('dlg-checkout');return;}
  const total=cart.reduce((s,i)=>s+i.price,0);
  document.getElementById('dlg-checkout-txt').innerHTML='<b>Order Summary</b><br><br>'+cart.map(i=>`${i.title} — ${i.lic} — $${i.price}`).join('<br>')+'<br><br><b>Total: $'+total+'</b><br><br>Redirecting to secure payment gateway...';
  showDlg('dlg-checkout');
}

